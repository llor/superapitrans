# =============================================
# chofocles — DEV (debian.saycusoft.es / saycudev)
# =============================================
# Copia a .env en el servidor dev. NO commitear .env real.

# API
PORT=3411
LOG_FORMAT=dev

# PostgreSQL — comparte instancia con saycutrans/saycucontrol
# (contenedor system-postgres en saycudev)
DB_HOST=system-postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CAMBIAR
DB_POOL_MAX=10

# JWT (sesión web + app móvil) — mismas claves que saycutrans para reutilizar tokens.js
JWT_SECRET=CAMBIAR
JWT_REFRESH_SECRET=CAMBIAR
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Cifrado de credenciales SMTP/IMAP de buzones de chofer
# AES-256-GCM. Valor: 32 bytes en base64.
# Generar con:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CHOFOCLES_SECRETS_KEY=CAMBIAR

# Storage de documentos originales (PDF/DOCX/imagen recibidos por email)
# Ruta dentro del contenedor api. Debe ser volumen persistente en docker.
DOCUMENTOS_STORAGE_PATH=/var/chofocles/documentos

# URL pública del API que el panel chofocles usará (build-time arg).
# system-caddy strippea /chofocles/ y reescribe a /api{path}, por lo que
# este valor NO debe llevar /api al final.
VITE_API_BASE=https://dev-api.superapi.eoden.es/chofocles

# Frecuencia (segundos) del bucle del ingestor IMAP. Cada ciclo recorre
# todas las empresas con servicio chofocles activo.
POLL_INTERVAL_SECONDS=120

# IA Claude — para generar plantillas nuevas cuando ninguna existente casa
# con un documento entrante. La salida pasa por doble validación interna
# del propio modelo; en discrepancia → ticket urgente.
ANTHROPIC_API_KEY=CAMBIAR
CHOFOCLES_AI_MODEL=claude-opus-4-7
CHOFOCLES_AI_MAX_TOKENS=4000
CHOFOCLES_AI_EFFORT=max

# Sistema de tickets transversal (admin.saycusoft.es). El ingestor abre
# tickets aquí cuando la IA falla o un documento revienta. URL pública
# para evitar acoplar la red docker entre proyectos.
TICKETS_API_URL=https://dev-admin.saycusoft.es/api/tickets
TICKETS_SERVICE_KEY=CAMBIAR

# IMAP — dos modos:
#   per_chofer (legacy): cada chofer_buzones tiene su IMAP independiente.
#   central:             1 catch-all en mail.saycusoft.es captura
#                        '*@chofocles.es' y se enruta por destinatario.
# El modo central se activa cuando IMAP_MODE=central Y están definidas
# IMAP_CENTRAL_HOST/USER/PASSWORD. Si falta cualquiera, cae a per_chofer.
IMAP_MODE=per_chofer
IMAP_CENTRAL_HOST=mail.saycusoft.es
IMAP_CENTRAL_PORT=993
IMAP_CENTRAL_USER=catchall@chofocles.es
IMAP_CENTRAL_PASSWORD=CAMBIAR
IMAP_CENTRAL_SSL=true
IMAP_CENTRAL_FOLDER=INBOX

# Cron de reasignación interna (chofocles_api). Reasigna viajes pendientes
# que rebasan el timeout al siguiente chofer de la empresa según el orden
# definido por el "jefe" en su panel.
CHOFOCLES_REASIGNACION_ENABLED=false
CHOFOCLES_REASIGNACION_CRON=* * * * *
CHOFOCLES_REASIGNACION_DEFAULT_MIN=30
