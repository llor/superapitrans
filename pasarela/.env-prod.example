# =============================================
# pasarela — PROD (debian.saycusoft.es / saycu)
# =============================================
# Copia a .env en el servidor prod. NO commitear .env real.

PORT=3412
LOG_FORMAT=combined

DB_HOST=system-postgres
DB_PORT=5432
# Usuario owner de las BDs saycu_pasarela_<tenant>. Coincide con SVC_PGUSER
# del admin api (auto-provisiona como este usuario), por lo que tiene
# permisos en saycu_admin y en cada BD tenant. Cambiar SOLO si se rota.
DB_USER=saycutrans
DB_PASSWORD=CAMBIAR
DB_POOL_MAX=20
SAYCU_ADMIN_DB=saycu_admin

PASARELA_SECRETS_KEY=CAMBIAR

# URL pública del API que el panel web embebe en su build.
# DEV: https://dev-api.saycunode.saycutrans.es/pasarela
# PROD: https://api.saycunode.saycutrans.es/pasarela
VITE_API_BASE=https://api.saycunode.saycutrans.es/pasarela

# Secreto de firma para los JWT del panel web (POST /api/auth/login →
# Authorization: Bearer en /api/me/*). Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=CAMBIAR
JWT_EXPIRES_IN=12h

PASARELA_SYNC_ENABLED=true
PASARELA_SYNC_CRON=*/5 * * * *

# DRY RUN: si true, sincroniza a BD pero NO confirma con commit a Satelles
# (las publicaciones quedan en su cola y se pueden volver a descargar).
# Útil para verificar mapeos antes de "consumir" las rutas reales. Quitar o
# poner a false cuando se haya validado.
PASARELA_DRY_RUN=false

# ControlGlobal — receptor central de eventos de login/versiones del grupo
# (admin.saycusoft.es). El backend reporta cada login (fire-and-forget, nunca
# bloquea). PROD: https://admin.saycusoft.es/api/control-global
CONTROL_GLOBAL_URL=https://admin.saycusoft.es/api/control-global
# Secreto compartido con el receptor (cabecera X-Control-Global-Secret).
CONTROL_GLOBAL_SECRET=CAMBIAR

TZ=Europe/Madrid
