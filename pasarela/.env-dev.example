# =============================================
# pasarela — DEV (debian.saycusoft.es / saycudev)
# =============================================
# Copia a .env en el servidor dev. NO commitear .env real.

# API
PORT=3412
LOG_FORMAT=dev

# PostgreSQL — comparte instancia con el resto del grupo Saycu
# (contenedor system-postgres).
DB_HOST=system-postgres
DB_PORT=5432
# Usuario owner de las BDs saycu_pasarela_<tenant>. Coincide con SVC_PGUSER
# del admin api (auto-provisiona como este usuario), por lo que tiene
# permisos en saycu_admin y en cada BD tenant. Cambiar SOLO si se rota.
DB_USER=saycutrans
DB_PASSWORD=CAMBIAR
DB_POOL_MAX=10
SAYCU_ADMIN_DB=saycu_admin

# Cifrado AES-256-GCM de credenciales de proveedores externos.
# 32 bytes en base64. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PASARELA_SECRETS_KEY=CAMBIAR

# URL pública del API que el panel web embebe en su build.
# DEV: https://dev-api.superapi.eoden.es/pasarela
# PROD: https://api.superapi.eoden.es/pasarela
VITE_API_BASE=https://dev-api.superapi.eoden.es/pasarela

# Secreto de firma para los JWT del panel web (POST /api/auth/login →
# Authorization: Bearer en /api/me/*). Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=CAMBIAR
JWT_EXPIRES_IN=12h

# Cron de sincronización con proveedores. true para activar.
PASARELA_SYNC_ENABLED=false
PASARELA_SYNC_CRON=*/5 * * * *

TZ=Europe/Madrid
